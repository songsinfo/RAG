# Copy to .runtime/demo.env using Initialize-Demo.ps1. Never commit real credentials.
RAG_ENVIRONMENT=demo
COMPOSE_PROJECT_NAME=rag-demo
DB_NAME=rag_demo
DB_PORT=3307
MILVUS_PORT=19530
MILVUS_HOST=127.0.0.1
MILVUS_URI=http://localhost:19530
DOCLING_PORT=5001
DB_URL=jdbc:mysql://localhost:3307/rag_demo?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
DB_USER=rag
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
RAG_SEED_PASSWORD=
RAG_CSRF_SECRET=
DOCLING_API_KEY=
DOCLING_URL=http://localhost:5001
# Unified Docling HybridChunker settings for PDF/DOCX/MD/TXT/etc.
DOCLING_CHUNK_MAX_TOKENS=400
DOCLING_PARENT_MAX_TOKENS=1200
DOCLING_CHUNK_TOKENIZER=sentence-transformers/all-MiniLM-L6-v2
DOCLING_CHUNK_MERGE_PEERS=true
RAG_INDEX_PREFIX=rag_demo
# Python 后端通过 LiteLLM AI Gateway 调用 Chat/Embedding/Reranker 模型，供应商真实密钥由网关持有
LITELLM_PORT=4000
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-litellm-internal-master-key
MODEL_BASE_URL=
MODEL_API_KEY=
CHAT_MODEL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1024
# RERANK_MODEL must map to a provider/model that exposes a rerank endpoint through LiteLLM.
RERANK_MODEL=

# Durable worker / artifact storage
RAG_EMBEDDED_WORKER=true
RAG_ARTIFACT_STORE=local
# Set RAG_ARTIFACT_STORE=s3 to use S3/MinIO.
S3_ENDPOINT_URL=http://localhost:9001
S3_BUCKET=rag-artifacts
S3_ACCESS_KEY_ID=ragadmin
S3_SECRET_ACCESS_KEY=rag-minio-demo-secret
S3_REGION=us-east-1
RERANK_MODEL=

# Agent runtime
AGENT_TIMEOUT_SECONDS=120
AGENT_MAX_ROUNDS=6
AGENT_MAX_TOOL_CALLS=8
AGENT_REPEAT_CALL_LIMIT=3
AGENT_MAX_CONTEXT_TOKENS=20000
AGENT_MAX_TOTAL_TOKENS=50000
AGENT_MAX_MODEL_CALLS=12
AGENT_CALL_MAX_ATTEMPTS=3
AGENT_RETRY_BASE_DELAY_SECONDS=0.25
AGENT_CIRCUIT_FAILURE_THRESHOLD=5
AGENT_CIRCUIT_RESET_SECONDS=30
AGENT_FALLBACK_MODEL_ALIAS=
AGENT_APPROVAL_TOOLS=
AGENT_PROMPT_VERSION=agent-v1.1

# Embedded worker pool isolation
RAG_QA_WORKERS=4
RAG_INGEST_WORKERS=2
RAG_EVAL_WORKERS=1

# OpenTelemetry (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=rag-backend
